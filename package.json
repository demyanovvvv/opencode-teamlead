{
  "name": "opencode-teamlead-source",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "description": "Production adaptive development accelerator for OpenCode 1.x",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm test",
    "e2e:host": "node scripts/host-smoke.mjs",
    "e2e:host:plan": "node scripts/host-smoke.mjs --command lead-plan",
    "release:bundle": "node scripts/release-bundle.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "manifest:write": "node scripts/manifest.mjs --write",
    "manifest:check": "node scripts/manifest.mjs",
    "payload:check": "node scripts/payload-boundary.mjs"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@opencode-ai/sdk": "^1.18.31",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.8.3"
  }
}
